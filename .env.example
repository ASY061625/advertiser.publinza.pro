###############################################################################
# Application
###############################################################################
APP_NAME=Publinza
APP_ENV=local                        # local | staging | production
APP_KEY=                             # php artisan key:generate
APP_DEBUG=true                       # MUST be false outside local
APP_TIMEZONE=UTC
APP_URL=http://publinza.localhost    # Apex URL. Production: https://publinza.pro
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

###############################################################################
# Surfaces
#
# Each of the three surfaces is bound to a hostname or path in bootstrap/app.php.
###############################################################################
MARKETING_DOMAIN=publinza.localhost      # Production: publinza.pro
APP_DOMAIN=app.publinza.localhost        # Production: app.publinza.pro
ADMIN_PATH_PREFIX=asylogin               # Admin panel path on the apex domain
APP_SUBDOMAIN_URL=http://app.publinza.localhost   # Where marketing CTAs point. Production: https://app.publinza.pro
FORCE_HTTPS=false                        # true on staging and production

###############################################################################
# Database — MySQL 8
###############################################################################
DB_CONNECTION=mysql
DB_HOST=mysql                        # 127.0.0.1 when running outside Docker
DB_PORT=3306
DB_DATABASE=publinza
DB_USERNAME=publinza
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret              # Docker Compose only
FORWARD_DB_PORT=3306                 # Host port mapped to MySQL

###############################################################################
# Redis — cache, sessions and queues all run on Redis
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0                           # Queues and locks
REDIS_CACHE_DB=1                     # Application cache
REDIS_HORIZON_DB=2                   # Horizon metrics, kept off the cache DB
REDIS_QUEUE=default
REDIS_PREFIX=publinza_database_
FORWARD_REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=publinza_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=publinza_session
SESSION_DOMAIN=                      # Production: .publinza.pro (shared apex + app)
SESSION_SECURE_COOKIE=false          # true wherever HTTPS is served

QUEUE_CONNECTION=redis

###############################################################################
# Horizon — queue supervisor, served at /asylogin/horizon behind the admin guard
###############################################################################
HORIZON_DOMAIN=
HORIZON_PATH=asylogin/horizon
HORIZON_PREFIX=publinza_horizon:

###############################################################################
# Meilisearch — Scout driver for the catalog
###############################################################################
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_PREFIX=publinza_
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKeyForLocalDevelopmentOnly   # Rotate outside local
FORWARD_MEILISEARCH_PORT=7700

###############################################################################
# Filesystem — S3 for content drafts, invoices and screenshots
###############################################################################
FILESYSTEM_DISK=s3                   # `local` is fine for local development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=publinza-media
AWS_URL=
AWS_ENDPOINT=                        # Set for MinIO or another S3-compatible store
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Mail — Mailpit locally, SES in production
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=hello@publinza.pro
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025  # Web UI at http://localhost:8025

###############################################################################
# Analytics — marketing site only
#
# Injected only after a visitor accepts cookies. Leave empty to ship no
# analytics at all; the banner still explains the essential cookie.
###############################################################################
ANALYTICS_SCRIPT_URL=

###############################################################################
# Payments
###############################################################################
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

###############################################################################
# SEO metric providers — used to refresh catalog traffic, DR, DA, spam score
###############################################################################
AHREFS_API_TOKEN=
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

###############################################################################
# Catalog and billing
###############################################################################
CATALOG_PER_PAGE=50
CATALOG_RANGES_TTL=60                # Minutes the quant-bar ranges stay cached
BILLING_CURRENCY=USD
BILLING_MIN_TOP_UP=1000              # Minor units — $10.00

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                      # `warning` or above in production
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

###############################################################################
# Local tooling — Docker Compose and Vite
###############################################################################
UID=1000                             # `id -u` — keeps container-written files editable
GID=1000                             # `id -g`
NGINX_PORT=80
VITE_PORT=5173
