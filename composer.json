{
    "name": "publinza/publinza",
    "type": "project",
    "description": "Publinza — guest-post marketplace. Marketing site, advertiser app and admin panel from one codebase.",
    "keywords": ["laravel", "inertia", "marketplace"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^1.3",
        "laravel/framework": "^11.9",
        "laravel/horizon": "^5.24",
        "laravel/scout": "^10.11",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.28",
        "meilisearch/meilisearch-php": "^1.8",
        "predis/predis": "^2.2",
        "pragmarx/google2fa-laravel": "^2.2",
        "tightenco/ziggy": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^2.34",
        "pestphp/pest-plugin-laravel": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
