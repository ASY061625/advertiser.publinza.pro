{
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSameLine": false,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindConfig": "./tailwind.config.ts",
    "overrides": [
        {
            "files": "*.{yml,yaml,json}",
            "options": { "tabWidth": 2 }
        }
    ]
}
